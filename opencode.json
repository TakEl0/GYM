{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "model": "google/gemini-3.5-flash-lite",
  "small_model": "google/gemini-3.5-flash-lite",
  "lsp": true,
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "mcp": {
    "opendesign": {
      "type": "local",
      "command": [
        "node",
        ".opencode/mcp/opendesign-server.js"
      ],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "node",
        ".opencode/mcp/context7-server.js"
      ],
      "enabled": true
    }
  }
}
